{
  "schemaVersion": 1,
  "id": "ande.launcher",
  "name": "Tiled Launcher",
  "version": "0.7.0",
  "author": "Ande Jacobs",
  "license": "MIT",
  "description": "Omarchy launcher with a 2x4 grid of app tiles beside the stock menu",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": false,
  "entryPoints": {
    "menu": "Menu.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Tiled Launcher",
    "description": "Opens the tiled Omarchy launcher",
    "category": "Compositor",
    "allowMultiple": false
  }
}
